{
  "name": "bsma-backdraft-flashover-landing",
  "private": true,
  "version": "1.0.0",
  "description": "Cinematic 3D landing page (Three.js + GSAP ScrollTrigger + Howler.js) about backdraft vs flashover",
  "scripts": {
    "build": "esbuild src/main3d.js --bundle --minify --format=iife --target=es2019 --outfile=js/scene.js",
